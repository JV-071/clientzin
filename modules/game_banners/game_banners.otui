GameBannerPanel < UIWidget
  size: 355 128
  phantom: true
  focusable: false
  visible: false
  clipping: false
  opacity-composite: true
  drop-shadow: true
  drop-shadow-offset: 8 8
  drop-shadow-opacity: 0.35

  UIWidget
    id: bannerIcon
    size: 72 75
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 2
    margin-top: 22
    clipping: false
    image-smooth: true
    image-fixed-ratio: true
    phantom: true

    UIWidget
      id: bannerIconSpell
      size: 32 32
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-top: -1
      image-source: /images/game/spells/spell-icons-32x32
      image-smooth: true
      phantom: true
      visible: false

    UIWidget
      id: bannerIconSpellBorder
      size: 40 40
      anchors.horizontalCenter: bannerIconSpell.horizontalCenter
      anchors.verticalCenter: bannerIconSpell.verticalCenter
      image-source: /images/game/banners/border-vocationinfo-spells
      image-smooth: true
      phantom: true
      visible: false

    UIItem
      id: bannerIconItem
      size: 64 64
      image-size: 64 64
      fixed-item-size: true
      virtual: true
      phantom: true
      visible: false
      show-count: false
      always-show-count: false
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-top: -1

    UIWidget
      id: bannerIconPicture
      size: 72 75
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      image-smooth: true
      image-fixed-ratio: true
      phantom: true
      visible: false

  UICreature
    id: bannerIconCreature
    size: 64 64
    anchors.top: bannerIcon.top
    anchors.left: bannerIcon.left
    margin-left: 4
    margin-top: 5
    fixed-creature-size: true
    base-scale: true
    creature-center: true
    ignore-displacement-shift: true
    clipping: false
    phantom: true
    visible: false

  UIWidget
    id: bannerIconOverlay
    size: 72 75
    anchors.left: bannerIcon.left
    anchors.top: bannerIcon.top
    image-smooth: true
    image-fixed-ratio: true
    phantom: true
    visible: false

  Panel
    id: bannerClipPanel
    size: 289 88
    anchors.left: bannerIcon.right
    anchors.top: bannerIcon.top
    margin-left: -74
    margin-top: 17
    clipping: false
    phantom: true
    visible: false

    UIWidget
      id: backdropBottomAnim
      size: 289 88
      anchors.left: parent.left
      anchors.top: parent.top
      image-source: /images/game/banners/backdrop-infobanner-bottom
      image-smooth: true
      image-fixed-ratio: false
      phantom: true

    // Texto sempre na posicao final (289); o clip cresce L->R e so revela
    Panel
      id: bannerTextClip
      size: 289 88
      anchors.left: parent.left
      anchors.top: parent.top
      clipping: true
      phantom: true

      UIWidget
        id: bannerContentLayer
        size: 289 88
        anchors.left: parent.left
        anchors.top: parent.top
        phantom: true
        clipping: false

        Label
          id: bannerTitle
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          margin-top: 10
          font: Verdana-14px-banner
          text-align: center
          color: #ffffff
          text-auto-resize: true
          text-offset: 29 4
          visible: true
          phantom: true

        Panel
          id: textPanel
          anchors.top: bannerTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 13
          margin-left: 73
          margin-right: 16
          height: 24
          clipping: true
          phantom: true
          visible: true

          Label
            id: bannerDescription
            anchors.fill: parent
            font: $var-cip-font-new
            text-align: top
            padding-top: 3
            color: #c0c0c0
            text-auto-resize: false
            text-wrap: true
            phantom: true

  UIWidget
    id: backdropMid
    size: 11 40
    anchors.left: bannerClipPanel.left
    anchors.top: bannerClipPanel.top
    margin-top: -6
    image-source: /images/game/banners/backdrop-infobanner-mid
    image-smooth: true
    image-fixed-ratio: true
    visible: false
    phantom: true

  UIWidget
    id: backdropTop
    size: 10 25
    anchors.left: bannerClipPanel.left
    anchors.bottom: bannerClipPanel.bottom
    margin-left: 47
    margin-bottom: 19
    image-source: /images/game/banners/backdrop-infobanner-top
    image-smooth: true
    image-fixed-ratio: true
    visible: false
    phantom: true

  UIWidget
    id: rollAnim
    size: 21 105
    anchors.left: bannerIcon.right
    anchors.top: parent.top
    margin-left: 0
    margin-top: 21
    image-smooth: true
    image-fixed-ratio: true
    visible: false
    phantom: true
