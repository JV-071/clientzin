SafeFightBox < CombatBox
  image-source: /images/inventory/button-combat-pvp-small-up
  image-clip: 0 0 20 20

  $checked:
    image-source: /images/inventory/button-combat-pvp-small-down
    image-clip: 0 0 20 20

  $!checked pressed:
    image-source: /images/inventory/button-combat-pvp-small-down
