GemDetailPanel < UIWidget
  UIWidget
    id: fragmentType0
    size: 50 50
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 43
    margin-top: 16
    image-source: /images/game/wheel/backdrop_modgrades
    image-clip: 0 0 50 50
    image-shader: image_black_white
    visible: true
    @onClick: modules.game_wheel.GemAtelier.onModRedirect(self)
    @onHoverChange: modules.game_wheel.GemAtelier.onHoverGem(self, self:isHovered())
    UIWidget
      id: hover
      size: 50 50
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      image-source: /images/game/wheel/backdrop_modgrades
      image-smooth: true
      image-clip: 200 0 50 50
      phantom: true
      visible: false
    UIWidget
      id: gemModItem0
      size: 30 30
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      image-source: /images/game/wheel/icons-skillwheel-basicmods
      image-shader: image_black_white
      image-clip: 30 0 30 30
      visible: true
      phantom: true
    UIWidget
      id: potential
      size: 50 50
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      image-source: /images/game/wheel/icons-modgrades-potential
      image-smooth: true
      image-clip: 0 0 50 50
      phantom: true
      visible: false

  UIWidget
    id: modLabel0
    size: 192 30
    !text: tr('+3%% Fire Resistence')
    text-auto-resize: false
    font: Verdana Bold-11px
    color: #707070
    anchors.top: prev.bottom
    anchors.left: parent.left
    text-align: center
    margin-top: 9
    margin-left: -29
    visible: true

