MultiHelperAssignPreview < Panel
  height: 34
  phantom: true
  focusable: false

  UIWidget
    id: previewIcon0
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    size: 32 32
    image-size: 32 32
    margin-top: -1
    visible: false

  UIWidget
    id: previewIcon1
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    size: 32 32
    image-size: 32 32
    margin-top: -1
    visible: false

  UIWidget
    id: previewIcon2
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    size: 32 32
    image-size: 32 32
    margin-top: -1
    visible: false

  Label
    id: previewLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 37
    margin-top: -1
    font: $var-cip-font-new
    color: #C0C0C0
    text-align: left

MultiHelperPreview < UICheckBox
  height: 34
  focusable: true
  text-offset: 38 9
  change-cursor-image: false
  font: $var-cip-font-new
  color: #c0c0c0

  $!checked:
    background-color: alpha
    color: #c0c0c0

  $checked:
    background-color: #585858
    color: #ffffff

  UIWidget
    id: image
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    focusable: false
    margin-left: 2
    size: 32 32
    image-size: 32 32

  Label
    id: helperName
    anchors.left: image.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    focusable: false
    margin-left: 6
    font: $var-cip-font-new
    color: #c0c0c0
    text-align: left

NewMainWindow
  id: assignMultiHelperWindow
  size: 275 500
  font: $var-cip-font-new
  color: #909090
  text-offset: 0 2
  @onEscape: self:destroy()

  Panel
    id: contentPanel
    anchors.fill: parent
    margin: 12 12 12 12

    MultiHelperAssignPreview
      id: preview
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 9

    TextList
      id: helperList
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: separatorBottom.top
      margin-top: 11
      margin-bottom: 11
      padding: 1
      focusable: true
      vertical-scrollbar: listScrollBar
      image-source: /images/ui/1pixel-down-frame
      image-border: 3
      border-width: 0
      background-color: alpha

    VerticalQtScrollBar
      id: listScrollBar
      anchors.top: helperList.top
      anchors.right: helperList.right
      margin: 1 1 1 0
      anchors.bottom: helperList.bottom
      step: 34
      pixels-scroll: true

    HorizontalSeparator
      id: separatorBottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buttonApply.top
      margin-bottom: 11
      height: 2

    Button
      id: buttonOk
      size: 43 20
      anchors.right: buttonApply.left
      anchors.bottom: parent.bottom
      margin-right: 6
      text: Ok
      text-offset: 0 0

    Button
      id: buttonApply
      size: 43 20
      anchors.right: buttonClose.left
      anchors.bottom: parent.bottom
      margin-right: 6
      text: Apply
      text-offset: 0 0

    Button
      id: buttonClose
      size: 43 20
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      text: Cancel
      text-offset: 0 0
