    phantom: true
    margin-top: 2
    image-source: /images/game/topbar/icon-combopoint-empty

StatsBarProficiencyButtonDefault < Panel
  id: proficiencyButtonColumn
  size: 13 13
  fixed-size: true
  phantom: true
  clipping: false

  UIButton
    id: proficiencyButton
    size: 13 13
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/game/topbar/proficiency-button-default
    image-clip: 0 0 13 13
    !tooltip: tr('Open Weapon Proficiency Dialog')
    tooltip-delayed: true
    @onClick: modules.game_proficiency.requestOpenWindow()
    $hover !pressed:
      image-clip: 0 0 13 13
    $pressed:
      image-clip: 0 13 13 13

  UIWidget
    id: highlightProficiencyButton
    size: 15 15
    phantom: true
    clipping: false
    image-source: /images/animations/button-highlight-15x15
    anchors.horizontalCenter: proficiencyButton.horizontalCenter
    anchors.verticalCenter: proficiencyButton.verticalCenter
    visible: false

StatsBarProficiencyButtonCompact < Panel
  id: proficiencyButtonCompactWrap
  size: 14 14
  fixed-size: true
  phantom: true
  clipping: false
  focusable: false

  UIButton
    id: proficiencyButtonCompact
    anchors.fill: parent
    image-source: /images/game/topbar/proficiency-button-compact-unequipped
    image-clip: 0 0 14 14
    !tooltip: tr('Open Weapon Proficiency Dialog')
    tooltip-delayed: true
    @onClick: modules.game_proficiency.requestOpenWindow()
    $hover !pressed:
      image-clip: 0 0 14 14
    $pressed:
      image-clip: 0 14 14 14

  Panel
    id: proficiencyButtonCompactProgress
    size: 14 14
    anchors.fill: parent
    phantom: true
    clipping: false
    focusable: false
    visible: false

  UIWidget
    id: highlightProficiencyButtonCompact
    size: 14 14
    phantom: true
    clipping: false
    image-source: /images/animations/button-highlight-15x14
    anchors.horizontalCenter: proficiencyButtonCompact.horizontalCenter
    anchors.verticalCenter: proficiencyButtonCompact.verticalCenter
    visible: false

StatsBarProficiencyButtonLarge < Panel
  id: proficiencyButtonLargeWrap
  size: 27 27
