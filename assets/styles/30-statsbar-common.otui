// --- Barras de valor (vertical / placement left-right) ---
// Fill cresce de baixo para cima. Texto horizontal rodado -90 no centro da barra.

StatsBarLeftWithShrink < UIWidget
  clipping: true

  UIWidget
    id: statsBarLeftBackground
    anchors.fill: parent
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 2
    image-repeated: true

    UIWidget
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-right: 2
      height: 98
      focusable: false
      image-source: /images/game/topbar/borderimage-statusbar-left
      @onGeometryChange: function(self) local w = math.min(98, self:getWidth()); if w > 0 then self:setImageClip(string.format('0 0 %d 98', w)); self:setImageSize(tosize(string.format('%d 98', w))) end end

StatsBarRightWithShrink < UIWidget
  clipping: true

  UIWidget
    id: statsBarRightBackground
    anchors.fill: parent
    image-source: /images/ui/2pixel-up-frame-borderimage
    image-border: 2
    image-repeated: true

    UIWidget
      anchors.top: parent.top
      anchors.right: parent.right
      width: 98
      height: 98
      focusable: false
      image-source: /images/game/topbar/borderimage-statusbar-right
      @onGeometryChange: function(self) local parent = self:getParent(); local avail = parent and math.max(0, parent:getWidth() - 2) or self:getWidth(); local w = math.min(98, avail); if w > 0 then if self:getWidth() ~= w then self:setWidth(w) end; self:setImageClip(string.format('%d 0 %d 98', 98 - w, w)); self:setImageSize(tosize(string.format('%d 98', w))) end end

