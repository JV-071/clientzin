// =============================================================================
// 30-statsbar-common.otui — estilos partilhados da stats bar (carga antes de statsbar_*.otui)
// Barras, fundos e grades usados por top/bottom e futuros placements laterais.
// =============================================================================

// --- Fundos (9-slice) ---

StatsBarDarkBackground < UIWidget
  UIWidget
    anchors.fill: parent
    image-source: /images/ui/button-verydarkgrey-down
    image-border: 3

StatsBarLightBackground < UIWidget
  UIWidget
    anchors.fill: parent
    image-source: /images/ui/button-grey-down
    image-border: 3

// --- Grades (bordas / marcadores) ---

StatsHorizontalBarGrade < UIWidget
  UIWidget
    id: grade_border_1
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #ffffffff
    height: 1
    visible: false
    phantom: false

  UIWidget
    id: grade_border_2
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #ffffffff
    height: 1
    visible: false
    phantom: false

  UIWidget
    id: grade_border_3
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.top: parent.top
    background-color: #ffffffff
    width: 1
    visible: false
    phantom: false

  UIWidget
    id: grade_border_4
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    anchors.top: parent.top
    background-color: #ffffffff
    width: 1
    visible: false
    phantom: false

  UIWidget
    id: grade_left_1
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/bars/marker-top
    size: 7 11
    visible: false
    phantom: false

  UIWidget
    id: grade_left_2
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/bars/marker-top
    size: 7 11
    visible: false
    phantom: false

  UIWidget
    id: grade_right_1
    anchors.right: parent.right
    anchors.top: parent.top
    image-source: /images/bars/marker-top
    size: 7 11
    visible: false
    phantom: false

  UIWidget
    id: grade_right_2
    anchors.right: parent.right
    anchors.top: parent.top
    image-source: /images/bars/marker-top
    size: 7 11
    visible: false
    phantom: false

