StatsBarProficiencyPanelVertical < Panel
  id: proficiencyPanel
  visible: false
  size: 13 101
  fixed-size: true

  UIWidget
    id: proficiencyBg
    size: 13 100
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    image-source: /images/game/topbar/proficiency-bar-vertical
    !tooltip: tr('Proficiency Progress: 0 / 1750')
    tooltip-delayed: true

    ProgressBarSD
      id: starProgress
      anchors.fill: parent
      image-source: /images/bars/progressbar-teal-11px-vertical
      margin: 1 1 1 1
      percent: 0
      &vertical: true

    Panel
      id: proficiencyLabelSlot
      size: 64 11
      fixed-size: true
      clipping: false
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 1
      phantom: true

      Label
        id: proficiencyLabel
        text-align: center
        text-auto-resize: true
        rotation: -90
        clipping: false
        font: $var-cip-font
        color: #f4f4f4
        text: 0%
        phantom: true
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter

  UIWidget
    id: proficiencyIcon
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 9 11
    margin-top: -3
    phantom: true
    on: false
    rotation: -90
    image-source: /images/game/topbar/icon-proficiencytree-off
    $on:
      image-source: /images/game/topbar/icon-proficiencytree-on

StatsBarProficiencyPanelVerticalRight < Panel
  id: proficiencyPanel
  visible: false
  size: 13 101
  fixed-size: true

  UIWidget
    id: proficiencyBg
    size: 13 100
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    image-source: /images/game/topbar/proficiency-bar-vertical
    !tooltip: tr('Proficiency Progress: 0 / 1750')
    tooltip-delayed: true

    ProgressBarSD
      id: starProgress
      anchors.fill: parent
      image-source: /images/bars/progressbar-teal-11px-vertical
      margin: 1 1 1 1
      percent: 0
      &vertical: true
      &fillFromTop: true

    Panel
      id: proficiencyLabelSlot
      size: 64 11
      fixed-size: true
      clipping: false
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 1
      phantom: true

      Label
        id: proficiencyLabel
        text-align: center
        text-auto-resize: true
        rotation: 90
        clipping: false
        font: $var-cip-font
        color: #f4f4f4
        text: 0%
        phantom: true
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter

  UIWidget
    id: proficiencyIcon
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 9 11
    margin-bottom: -5
    margin-left: 1
    phantom: true
    on: false
    rotation: 90
    image-source: /images/game/topbar/icon-proficiencytree-off
    $on:
      image-source: /images/game/topbar/icon-proficiencytree-on
