// =============================================================================
// statsbar_right.otui ? placement RIGHT (coluna entre actionbar e sidebar)
// Depende de: 30-statsbar-common.otui
// Espelho da left: HP/MP à direita, skills/chrome à esquerda; rotation 90.
// =============================================================================

// --- Linha de skill (valor rodado + icone + barra vertical) ---

RightStatsSkillElement < UIWidget
  width: 19

  Panel
    id: statsbarXpBoostSlot
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    width: 0
    height: 0
    margin-top: 4
    margin-left: -2

    UIWidget
      id: statsbarXpBoostButton
      size: 14 76
      fixed-size: true
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      visible: false
      image-source: /images/ui/button-storexp-noborder-right-idle
      !tooltip: tr('Purchase XP Boost')
      tooltip-delayed: true
      @onClick: modules.game_store.openPremiumBoost()
      $pressed:
        image-source: /images/ui/button-storexp-noborder-right-pressed

  Panel
    id: levelSlot
    size: 20 40
    fixed-size: true
    clipping: false
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-left: -2
    margin-bottom: 1

    Label
      id: level
      !text: '999'
      font: $var-cip-font-new
      color: #c0c0c0
      text-align: left
      text-auto-resize: false
      size: 40 20
      fixed-size: true
      rotation: 90
      clipping: false
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-top: -1
      margin-left: 1

  UIWidget
    id: icon
    size: 9 9
    anchors.bottom: levelSlot.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-left: -2
    margin-bottom: 5

  StatsBarRightSkill
    id: bar
    anchors.top: statsbarXpBoostSlot.bottom
    anchors.bottom: icon.top
    anchors.horizontalCenter: parent.horizontalCenter
    !statsbar-size: 'tiny'
    !statsbar-orientation: 'vertical'
    statsbar-text: false
    margin-top: 6
    margin-bottom: 6
    margin-left: -2
    width: 5

RightStatsBarChromeColumn < Panel
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  width: 15
  phantom: true
  focusable: false

  Panel
    id: topBarProficiencyRowInner
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 14
    margin-right: 3
    phantom: true
    layout:
      type: verticalBox
      fit-children: true

    StatsBarMonkComboSereneVertical
      id: topBarMonkComboSerene
      margin-top: 9
      margin-bottom: 5

    Panel
      id: icons
      image-border: 3
      image-source: /images/ui/button-verydarkgrey-down
      size: 13 103
      fixed-size: true
      padding-top: 2
      &verticalIcons: true
      layout:
        type: verticalBox

    StatsBarProficiencyButtonDefault
      id: proficiencyButtonColumn
      margin-top: 2

    StatsBarProficiencyPanelVerticalRight
      id: proficiencyPanel
      margin-top: 1

// --- Large ---

RightStatsBarLargeOnRight < UIWidget
  StatsBarRightWithShrink
    anchors.fill: parent

  Panel
    id: barsColumn
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 27
    margin-right: 11
    margin-top: 4
    margin-bottom: 4

    StatsBarRight
      id: health
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: largeTopCenterRow.top
      width: 27
      !statsbar-type: 'health'
      !statsbar-size: 'large'
      !statsbar-orientation: 'vertical'
      statsbar-text: true
      margin-bottom: 6

    Panel
      id: largeTopCenterRow
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      width: 27
      phantom: true
      clipping: false
      focusable: false
      layout:
        type: verticalBox
        fit-children: true

      StatsBarMonkComboSereneVertical
        id: topBarMonkComboSereneLarge
        margin-bottom: 5

      Panel
        id: icons
        image-border: 3
        image-source: /images/ui/button-verydarkgrey-down
        size: 27 53
        fixed-size: true
        padding-top: 2
        &verticalIcons: true
        layout:
          type: verticalBox

      StatsBarProficiencyButtonLarge
        id: proficiencyButtonLargeWrap
        margin-top: 5

    StatsBarRightMana
      id: mana
      anchors.top: largeTopCenterRow.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 27
      !statsbar-type: 'mana'
      !statsbar-size: 'large'
      !statsbar-orientation: 'vertical'
      statsbar-text: true
      margin-top: 6

  Panel
    id: skills
    anchors.right: barsColumn.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 0
    width: 0

// --- Parallel ---

RightStatsBarParallelOnRight < UIWidget
  StatsBarRightWithShrink
    anchors.fill: parent

  StatsBarRightMana
    id: mana
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 14
    !statsbar-type: 'mana'
    !statsbar-size: 'small'
    !statsbar-orientation: 'vertical'
    statsbar-text: true
    margin-right: 11
    margin-top: 4
    margin-bottom: 4

  StatsBarRight
    id: health
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: mana.left
    width: 14
    !statsbar-type: 'health'
    !statsbar-size: 'small'
    !statsbar-orientation: 'vertical'
    statsbar-text: true
    margin-right: 3
    margin-top: 4
    margin-bottom: 4

  Panel
    id: skills
    anchors.right: health.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 0
    width: 0

  RightStatsBarChromeColumn
    id: rightBarProficiencyColumn
    anchors.right: skills.left

// --- Default ---

RightStatsBarDefaultOnRight < UIWidget
  StatsBarRightWithShrink
    anchors.fill: parent

  Panel
    id: barsColumn
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 14
    margin-right: 11
    margin-top: 4
    margin-bottom: 4

    StatsBarRight
      id: health
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.verticalCenter
      !statsbar-type: 'health'
      !statsbar-size: 'small'
      !statsbar-orientation: 'vertical'
      statsbar-text: true
      margin-bottom: 3

    StatsBarRightMana
      id: mana
      anchors.top: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      !statsbar-type: 'mana'
      !statsbar-size: 'small'
      !statsbar-orientation: 'vertical'
      statsbar-text: true
      margin-top: 2

  Panel
    id: skills
    anchors.right: barsColumn.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 0
    width: 0

  RightStatsBarChromeColumn
    id: rightBarProficiencyColumn
    anchors.right: skills.left

// --- Compact ---

RightStatsBarCompactOnRight < UIWidget
  StatsBarRightWithShrink
    anchors.fill: parent

  Panel
    id: barsColumn
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 15
    margin-right: 11
    margin-top: 4
    margin-bottom: 4

    StatsBarRight
      id: health
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: compactTopCenterRow.top
      width: 14
      !statsbar-type: 'health'
      !statsbar-size: 'small'
      !statsbar-orientation: 'vertical'
      statsbar-text: true
      margin-bottom: 6

    Panel
      id: compactTopCenterRow
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      width: 14
      phantom: true
      clipping: false
      focusable: false
      layout:
        type: verticalBox
        fit-children: true

      StatsBarMonkComboSereneVertical
        id: topBarMonkComboSereneCompact
        margin-bottom: 5

      Panel
        id: icons
        image-border: 3
        image-source: /images/ui/button-verydarkgrey-down
        size: 14 103
        fixed-size: true
        padding-top: 2
        &verticalIcons: true
        layout:
          type: verticalBox

      StatsBarProficiencyButtonCompact
        id: proficiencyButtonCompactWrap
        margin-top: 5

    StatsBarRightMana
      id: mana
      anchors.top: compactTopCenterRow.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 14
      !statsbar-type: 'mana'
      !statsbar-size: 'small'
      !statsbar-orientation: 'vertical'
      statsbar-text: true
      margin-top: 6

  Panel
    id: skills
    anchors.right: barsColumn.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: -1
    width: 0

// --- Agregador RightStatsBar ---

RightStatsBar < UIWidget
  RightStatsBarLargeOnRight
    id: largeOnRight
    anchors.fill: parent
    visible: false
    phantom: true

  RightStatsBarParallelOnRight
    id: parallelOnRight
    anchors.fill: parent
    visible: false
    phantom: true

  RightStatsBarDefaultOnRight
    id: defaultOnRight
    anchors.fill: parent
    visible: false
    phantom: true

  RightStatsBarCompactOnRight
    id: compactOnRight
    anchors.fill: parent
    visible: false
    phantom: true
