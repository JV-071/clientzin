CreatureButton < UICreatureButton
  height: 20
  margin-bottom: 0

  UICreature
    id: creature
    size: 18 18
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 2
    margin-top: 1
    phantom: true

  UIWidget
    id: spacer
    width: 5
    anchors.left: creature.right
    anchors.top: creature.top
    phantom: true

  UIWidget
    id: statusIcons
    size: 0 11
    anchors.right: lifeBar.right
    anchors.bottom: lifeBar.top
    margin-bottom: 3
    phantom: true
    layout:
      type: horizontalBox
      spacing: 2

    UIWidget
      id: iconsMonsterSlot3
      size: 11 11
      visible: false
      phantom: true

    UIWidget
      id: iconsMonsterSlot2
      size: 11 11
      visible: false
      phantom: true

    UIWidget
      id: iconsMonsterSlot1
      size: 11 11
      visible: false
      phantom: true

    UIWidget
      id: emblem
      size: 11 11
      visible: false
      phantom: true

    UIWidget
      id: partyShield
      size: 11 11
      visible: false
      phantom: true

    UIWidget
      id: skull
      size: 11 11
      visible: false
      phantom: true

  Label
    id: label
    height: 16
    anchors.left: spacer.right
    anchors.right: statusIcons.left
    anchors.top: parent.top
    color: #888888
    margin-left: 1
    margin-right: 2
    margin-top: 1
    phantom: true
    font: verdana-11px-monochrome
    text-align: left

  LifeProgressBar
    id: lifeBar
    height: 5
    anchors.left: spacer.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 0
    margin-right: 0
    margin-top: 15
    phantom: true
